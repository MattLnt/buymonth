generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
}

enum Formule {
  PRO
  PRO_PLUS
}

enum BienStatut {
  ACTIF
  OPTION
  HORS_LIGNE
  VENDU
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  role        Role     @default(CLIENT)
  createdAt   DateTime @default(now())
  client      Client?
  resetTokens PasswordResetToken[]
}

model Client {
  id                 String     @id @default(cuid())
  userId             String     @unique
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  societe            String
  contactNom         String?
  contactOpe         String?
  contactFacturation String?
  telephone          String?
  adresse            String?
  adresseAdmin       String?
  numeroTva          String?
  logoUrl            String?
  formule            Formule    @default(PRO)
  miseEnServicePayee Boolean    @default(false)
  miseEnServiceAt    DateTime?
  stripeCustomerId   String?
  stripeSubId        String?
  subStatus          String?
  subEndsAt          DateTime?
  trialEndsAt        DateTime?
  biens              Bien[]
  createdAt          DateTime   @default(now())

  // --- déprécié (ancien modèle : abo fixe + widget payant). Conservé le temps de la migration. ---
  plan            String          @default("CLASSIC")
  widgetsGratuits Int             @default(0)
  widgetPayments  WidgetPayment[]
}

model Bien {
  id          String     @id @default(cuid())
  clientId    String
  client      Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  titre       String
  description String?
  prixTotal   Int
  mensualite  Int
  type        String?
  chambres    Int?
  sallesDeBain Int?
  surface     Int?
  terrasse    Int?
  jardin      Int?
  ville       String?
  province    String?
  adresse     String?
  projet      String?
  unite       String?
  pebNumero   String?
  pebClasse   String?
  pebKwh      String?
  images      String[]
  urlClient   String?
  statut      BienStatut @default(ACTIF)
  published   Boolean    @default(true)
  vues        Int        @default(0)
  leads       Lead[]
  widgets     Widget[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Widget {
  id        String   @id @default(cuid())
  bienId    String
  bien      Bien     @relation(fields: [bienId], references: [id], onDelete: Cascade)
  type      String
  premium   Boolean  @default(false)
  vues      Int      @default(0)
  createdAt DateTime @default(now())
}

// --- déprécié : le widget est désormais gratuit. Modèle conservé pour l'historique. ---
model WidgetPayment {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  bienId          String?
  montant         Int
  devise          String   @default("eur")
  statut          String   @default("paid")
  stripeSessionId String?
  createdAt       DateTime @default(now())
}

model Lead {
  id              String    @id @default(cuid())
  bienId          String?
  bien            Bien?     @relation(fields: [bienId], references: [id], onDelete: SetNull)
  nom             String?
  societe         String?
  email           String?
  telephone       String?
  revenu          Int?
  apport          Int?
  source          String
  statutPromoteur String    @default("À contacter")
  statutAdmin     String    @default("À contacter")
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
}

model Settings {
  id           String   @id @default("default")
  apportPct    Float    @default(0.10)
  tauxAnnuel   Float    @default(0.0345)
  dureeMois    Int      @default(300)
  leadEmails   String[]
  essaiActif   Boolean  @default(false)
  essaiJours   Int      @default(14)
  blocageActif Boolean  @default(false)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}